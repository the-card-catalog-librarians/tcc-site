---
import { Empty, EmptyHeader, EmptyMedia, EmptyTitle, EmptyDescription, EmptyContent } from "@/components/ui/empty.tsx"
import { Wrapper } from "@/components/Wrapper.tsx"
import { Construction } from "lucide-react"
import "@/styles/global.css"
---
<html lang="en">
<head>
  <!-- big thanks to Jan Antonin Kolar (https://unsplash.com/@jankolar) for the wonderfull banner image!  -->
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width" />
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <meta property="og:image" content="/banner.avif" />
  <link rel="sitemap" href="/sitemap-index.xml" />
  <meta name="robots" content="noindex" />

  <title>The Card Catalog</title>
</head>
<body>
<Wrapper client:load>
  <Empty>
    <EmptyHeader>
      <EmptyMedia variant={"icon"} className="size-10">
        <Construction className="size-10" />
      </EmptyMedia>
      <EmptyTitle className="text-3xl">Pardon Our Dust!</EmptyTitle>
      <EmptyDescription className="text-[16px]">The page you are looking for is under construction. Please check back at
        a later date.
      </EmptyDescription>
    </EmptyHeader>
  </Empty>
</Wrapper>
</body>
</html>
