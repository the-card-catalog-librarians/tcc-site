---
interface Props {
  episodeId: string
  theme?: "0" | "1"
}
const { episodeId, theme = "0" } = Astro.props
---

<div class="mx-auto p-2 md:max-h-2/3 md:max-w-2/3">
  <iframe
    style="border-radius:12px"
    src={`https://open.spotify.com/embed/episode/${episodeId}?utm_source=generator&theme=${theme}`}
    width="100%"
    height="152"
    allowfullscreen
    allow="autoplay; clipboard-write; encrypted-media; fullscreen; picture-in-picture"
    loading="lazy"
    class="mt-4"></iframe>
</div>
